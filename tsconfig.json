{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"allowJs": true,
		"checkJs": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	}
}
