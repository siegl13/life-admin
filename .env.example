ORIGIN=http://localhost:3000
TZ=Europe/Berlin
LIFEADMIN_DATA_DIR=/data
# LIFEADMIN_COOKIE_SECURE=true
# LIFEADMIN_RESET_OWNER_PASSWORD=replace-with-a-new-long-password

# AI document extraction (Slice 9) — off by default even with a key set,
# until an owner also switches it on in /settings with explicit consent.
# LIFEADMIN_OPENAI_API_KEY=sk-...
# Operator escape hatch only, not a product feature: override only if the
# default model is retired on your OpenAI account before this image updates.
# LIFEADMIN_AI_MODEL=gpt-5.6-terra
# Dev/test only. Ignored (and logged as ignored) when NODE_ENV=production.
# LIFEADMIN_AI_FAKE=1
